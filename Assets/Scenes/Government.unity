  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SpecialQuestMailBridge
  mailKey: SPECIAL_QUEST_QUAN_HUYEN_START_MAIL_SENT
  senderName: "Ph\u1EE7 huy\u1EC7n"
  mailContent: "M\u1ED9t sai d\u1ECBch t\u1EEB ph\u1EE7 huy\u1EC7n v\u1ED9i v\xE3
    t\xECm \u0111\u1EBFn y qu\xE1n.\n\nQuan Huy\u1EC7n nhi\u1EC1u ng\xE0y nay l\xE2m
    tr\u1ECDng b\u1EC7nh, h\u01A1i th\u1EDF suy y\u1EBFu, th\u1EA7n tr\xED m\xEA
    s\u1EA3ng, c\xE1c th\u1EA7y thu\u1ED1c trong v\xF9ng \u0111\u1EC1u ch\u01B0a
    t\xECm ra c\xE1ch ch\u1EEFa.\n\nPh\u1EE7 huy\u1EC7n truy\u1EC1n g\u1ECDi l\u01B0\u01A1ng
    y \u0111\u1EBFn ch\u1EA9n kh\xE1m ngay. H\xE3y \u0111\u1EBFn ph\u1EE7 huy\u1EC7n
    \u0111\u1EC3 xem b\u1EC7nh cho Quan Huy\u1EC7n."
  logDebug: 1
